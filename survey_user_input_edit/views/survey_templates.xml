<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="survey_button_retake"
        inherit_id="survey.survey_button_retake"
        priority="99"
    >
        <xpath expr="//div" position="replace">
            <div
                t-if="not answer.is_session_answer and not (survey.certification and answer.scoring_success)"
                class="d-print-none"
            >
                <p t-if="survey.allow_editing">
                    <a
                        role="button"
                        class="btn btn-primary btn-lg"
                        t-att-href="'/survey/start/%s?answer_token=%s&amp;edit=1' % (survey.access_token, answer.access_token)"
                    >
                        Edit your answers
                    </a>
                </p>
                <t t-else="">
                    <t t-if="survey.is_attempts_limited">
                        <t
                            t-set="attempts_left"
                            t-value="survey._get_number_of_attempts_lefts(answer.partner_id, answer.email, answer.invite_token)"
                        />
                        <p t-if="attempts_left > 0">
                            <span>Number of attempts left</span>: <span
                            t-out="attempts_left"
                        />
                            <a
                            role="button"
                            class="btn btn-primary btn-lg ms-3"
                            t-att-href="'/survey/retry/%s/%s' % (survey.access_token, answer.access_token)"
                        >
                                Retry
                            </a>
                        </p>
                    </t>
                    <p t-else="">
                        <a
                            role="button"
                            class="btn btn-primary btn-lg"
                            t-att-href="'/survey/retry/%s/%s' % (survey.access_token, answer.access_token)"
                        >
                            Take Again
                        </a>
                    </p>
                </t>
            </div>
        </xpath>
    </template>

    <template id="survey_fill_form" inherit_id="survey.survey_fill_form">
        <xpath expr="//form" position="attributes">
            <attribute
                name="t-att-data-users-can-go-back"
            >(survey.users_can_go_back or survey.allow_editing) and not answer.is_session_answer</attribute>
        </xpath>
    </template>

    <template id="survey_fill_header" inherit_id="survey.survey_fill_header">
        <xpath expr="//div[@t-att-data-can-go-back]" position="attributes">
            <attribute
                name="t-att-data-can-go-back"
            >survey.users_can_go_back or survey.allow_editing</attribute>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="survey_question_group_view_form" model="ir.ui.view">
        <field name="name">survey.question.group.form</field>
        <field name="model">survey.question.group</field>
        <field name="arch" type="xml">
            <form string="Question Group">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids" nolabel="1">
                                <tree>
                                    <field name="title" />
                                    <field name="question_type" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="survey_question_group_view_tree" model="ir.ui.view">
        <field name="name">survey.question.group.tree</field>
        <field name="model">survey.question.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="survey_question_group_action" model="ir.actions.act_window">
        <field name="name">Question Groups</field>
        <field name="res_model">survey.question.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="survey_question_group_menu"
        name="Question Groups"
        parent="survey.survey_menu_questions"
        action="survey_question_group_action"
        sequence="5"
    />

</odoo>

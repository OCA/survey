<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <!-- model.name form view -->
    <record id="survey_user_input_line_form" model="ir.ui.view">
      <field name="name">survey_user_input_line_form</field>
      <field name="model">survey.user_input.line</field>
      <field name="inherit_id" ref="survey.survey_user_input_line_view_form" />
      <field name="arch" type="xml">
        <xpath expr="//field[@name='value_text_box']" position="after">
          <field
                    name="value_signature"
                    attrs="{'invisible': [('answer_type','!=','signature')]}"
                    widget="signature"
                />
       </xpath>
      </field>
    </record>
</odoo>

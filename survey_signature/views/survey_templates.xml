<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template id="survey_signature.question_signature" name="question signature">
        <div
            class="card mt16 mb0 o_signature_container"
            t-att-data-name="question.id"
            t-att-data-value="answer_lines[0].value_signature if answer_lines else None"
            t-att-data-question-type="question.question_type"
        >
            <div class="card-header">
                <div class="float-right">
                    <button
                        type="button"
                        class="btn btn-primary btn-sm clear_sign"
                    >Clear</button>
                </div>
            </div>
            <div class="card-body signature" style="padding: 0" t-att-name="prefix" />
            </div>
    </template>
    <template
        id="custom_question_container"
        name="Survey container signature"
        inherit_id="survey.question_container"
    >
        <xpath expr="//div[hasclass('o_survey_question_error')]" position="before">
            <t t-if="question.question_type == 'signature'">
                <t t-call="survey_signature.question_signature">
                </t>
            </t>
        </xpath>
    </template>
</odoo>

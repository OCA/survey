<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="layout" inherit_id="survey.layout" priority="99">
        <xpath expr="//div[hasclass('o_survey_brand_message')]" position="replace">
            <div
                t-if="not no_survey_navigation"
                class="o_survey_navigation_wrapper d-inline-block d-print-none float-end rounded me-3"
                t-call="survey.survey_navigation"
            />
        </xpath>
    </template>
</odoo>
